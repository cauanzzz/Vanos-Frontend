# Public configuration bundled into the app. Never put JWTs or secrets here.
# Set the API origin, WITHOUT /api. HTTP and /hubs/tracking use it. No fallback URL.
# Android emulator (with a trusted TLS tunnel / reverse proxy):
# EXPO_PUBLIC_API_URL=https://your-development-api.example.com
# Physical device: use a reachable LAN hostname/IP with a trusted matching certificate,
# or a trusted HTTPS tunnel to the backend's HTTP port 5107.
EXPO_PUBLIC_API_URL=
# Android development build via USB: adb reverse tcp:5108 tcp:5108
# then use http://localhost:5108; see docs/android-stage-4.md. Local test API only.

# Android Maps SDK key: restricted by package com.cauanzzz.vanos + signing SHA-1.
# Used only by the native config plugin; changing it requires rebuilding the app.
# Not a backend secret. Never put JWTs or server signing keys here.
GOOGLE_MAPS_ANDROID_API_KEY=
