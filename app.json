{
  "expo": {
    "name": "Vanos",
    "slug": "vanos-mobile",
    "version": "1.0.0",
    "scheme": "vanos",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cauanzzz.vanos"
    },
    "android": {
      "package": "com.cauanzzz.vanos",
      "adaptiveIcon": {
        "backgroundColor": "#F6F5F0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Vanos usa sua localização para compartilhar a posição da van durante o rastreamento iniciado por você.",
          "locationAlwaysAndWhenInUsePermission": "O Vanos usa a localização em segundo plano para acompanhar a van enquanto o rastreamento do motorista estiver ativo.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ]
  }
}
