{
  "name": "vanos-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@gorhom/bottom-sheet": "5.2.14",
    "@microsoft/signalr": "^10.0.11",
    "axios": "^1.20.0",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.19",
    "expo-network": "~58.0.4",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-task-manager": "~58.0.12",
    "jwt-decode": "^4.0.0",
    "leaflet": "1.9.4",
    "nativewind": "4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-maps": "1.29.11",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.22",
    "@types/node": "24",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "tailwindcss": "3.4.17",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo start --dev-client --android",
    "ios": "expo start --dev-client --ios",
    "web": "expo start --web",
    "web:local": "expo start --web --localhost --port 8081 --max-workers 2",
    "api:local": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Start-LocalApi.ps1",
    "api:proxy": "node scripts/local-api-proxy.mjs",
    "api:check": "node scripts/check-local-auth.mjs",
    "tracking:check": "node --import tsx scripts/check-local-tracking.ts",
    "tracking:publish": "node scripts/publish-local-location.mjs",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.tests.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "doctor": "expo-doctor"
  },
  "private": true
}
